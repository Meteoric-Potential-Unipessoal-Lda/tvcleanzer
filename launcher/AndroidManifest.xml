<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tvcleanzer.launcher"
    android:versionCode="91"
    android:versionName="0.91">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- weather on the clock home screen (Open-Meteo); nothing else goes online -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- «Запущенные»: recently used apps; the phone app turns the access on over ADB (appops) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- the tuner's channel list, to open «ТВ» on the antenna rather than the last HDMI;
         granted by the phone app over ADB (pm grant) -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <!-- wallpaper and photo-frame pictures from a USB stick, chosen on the TV (FilesActivity) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- the TV's system language, set from the phone (Locales): granted over ADB (pm grant),
         never asked on the TV -->
    <uses-permission android:name="android.permission.CHANGE_CONFIGURATION" />
    <!-- «Экран гаснет без пульта» in the launcher settings: the TV's screen timeout;
         allowed by the phone app over ADB (appops WRITE_SETTINGS) -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Bluetooth pill (0.63): on/off and switching it; what is connected needs CONNECT on
         Android 12+, granted by the phone app over ADB (pm grant), never asked on the TV -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 0.69: after a reboot, put the Home-key service back if the TV dropped it (BootReceiver);
         WRITE_SECURE_SETTINGS is granted by the phone app over ADB (pm grant), never asked -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 0.79: the mouse pointer without the Home-key service (boxes that switch it off);
         granted by the phone over ADB (appops SYSTEM_ALERT_WINDOW), never asked on the TV -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- Android 11+: see the apps we show on the home screen -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- VPN apps: the corner's VPN icon opens the one in use (Vpn) -->
        <intent>
            <action android:name="android.net.VpnService" />
        </intent>
        <!-- the stock homes HomeKeyService replaces (Google TV launcherx among them), and who
             plays the inputs (on TCL Google TV, launcherx itself) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="android.media.tv" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- TV shell apps without a menu icon (AppEntry.FIRMWARE_APPS) -->
        <package android:name="com.yandex.tv.ytplayer" />
        <package android:name="com.yandex.devices.appstore" />
        <package android:name="com.yandex.browser.tv" />
        <!-- the TV's own live TV (antenna / cable / satellite) for the «ТВ» source (Inputs.tv) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.cursor.item/channel" />
        </intent>
        <package android:name="com.mediatek.wwtv.tvcenter" />
        <package android:name="com.google.android.tv" />
        <package android:name="com.android.tv" />
        <package android:name="com.sony.dtv.tvx" />
        <package android:name="org.droidtv.playtv" />
        <package android:name="com.xiaomi.mitv.tvplayer" />
        <package android:name="com.droidlogic.tvsource" />
        <package android:name="com.tcl.tv" />
        <package android:name="ru.sberdevices.starlivetv" />
        <package android:name="ru.sberdevices.tv" />
        <package android:name="com.yandex.tv.live" />
    </queries>

    <application
        android:label="TVCleanzer"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <activity
            android:name=".HomeActivity"
            android:theme="@style/HomeTheme"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <!-- The phone app applies settings over ADB:
             am broadcast -n com.tvcleanzer.launcher/.ConfigReceiver
                -a com.tvcleanzer.launcher.APPLY - -es skin aurora - -ez clock24 true - -ez labels false -->
        <!-- Some TV firmwares bring their own launcher back on Home.
             The phone app enables this service over ADB to keep ours. -->
        <service
            android:name=".HomeKeyService"
            android:label="@string/home_service_label"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_service" />
        </service>

        <!-- Clock screensaver; the phone app selects it when the firmware's own one is removed -->
        <service
            android:name=".ClockDream"
            android:label="@string/dream_label"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Photo frame: the owner's photos one after another, with the time; the phone app
             makes it the TV's screensaver only when the owner asks -->
        <service
            android:name=".PhotoDream"
            android:label="@string/photo_dream_label"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Read-only state for the phone app (ADB shell holds DUMP, apps don't) -->
        <!-- a photo / video sent from the phone's remote; started by the phone over ADB -->
        <activity
            android:name=".CastActivity"
            android:theme="@style/HomeTheme"
            android:exported="true"
            android:screenOrientation="landscape" />

        <!-- pictures from a USB stick / the TV's memory: wallpaper and photo frame -->
        <activity
            android:name=".FilesActivity"
            android:theme="@style/HomeTheme"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- «Кнопки пульта»: a remote button opens an app of the owner's choice -->
        <activity
            android:name=".KeyMapActivity"
            android:theme="@style/HomeTheme"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- «Запущенные»: our recent-apps row (TVs without a recents screen of their own) -->
        <activity
            android:name=".RecentsActivity"
            android:theme="@style/HomeTheme"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape" />

        <!-- «Повтор экрана»: started by the phone app over ADB with a one-time token -->
        <activity
            android:name=".MirrorActivity"
            android:theme="@style/HomeTheme"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape" />

        <provider
            android:name=".StateProvider"
            android:authorities="com.tvcleanzer.launcher.state"
            android:exported="true"
            android:readPermission="android.permission.DUMP"
            android:writePermission="android.permission.DUMP" />

        <!-- 0.71: every 15 min, kept over reboots, the Home-key service is put back if needed -->
        <service
            android:name=".KeeperJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ConfigReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.tvcleanzer.launcher.APPLY" />
                <action android:name="com.tvcleanzer.launcher.PASTE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
